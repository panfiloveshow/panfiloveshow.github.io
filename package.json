{
  "name": "sellico-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content-index.mjs && tsc -b && vite build && node scripts/prerender-routes.mjs && node scripts/check-seo.mjs && node scripts/check-query-map.mjs && node scripts/check-links.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "node --experimental-strip-types src/lib/unit-economics.test.ts && node --experimental-strip-types src/lib/calculators.test.ts && node --experimental-strip-types src/lib/calc-url.test.ts && node scripts/lastmod.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:queries": "node scripts/check-query-map.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.20",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.451.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.0.13"
  }
}
