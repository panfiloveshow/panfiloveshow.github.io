[Unit]
Description=Sellico Public Read-Only Streamable HTTP MCP Server
Documentation=https://sellico.ru/agents.md
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/landing
Environment=NODE_ENV=production
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=4180
Environment=MCP_DIST_DIR=/var/www/html/landing/dist
Environment=MCP_ORIGIN=https://sellico.ru
ExecStart=/usr/bin/node /var/www/html/landing/scripts/agent/server.mjs
Restart=on-failure
RestartSec=3

# Hardening: read-only access to built static artifacts, loopback-only listener
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/www/html/landing

[Install]
WantedBy=multi-user.target
